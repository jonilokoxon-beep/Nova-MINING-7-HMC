rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================
    // USERS
    // ==========================
    match /users/{userId} {
      allow read, write: if request.auth != null 
                         && request.auth.uid == userId;
    }

    // ==========================
    // PRODUCTS (Públicos para leer)
    // ==========================
    match /products/{productId} {
      allow read: if true;

      allow write: if request.auth != null 
                   && request.auth.token.email == "joni.lokoxon@gmail.com";
    }

    // ==========================
    // ORDERS (Solo del dueño)
    // ==========================
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
    }

    // ==========================
    // DEPOSITS (Solo del dueño)
    // ==========================
    match /deposits/{depositId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
    }

    // ==========================
    // WITHDRAWALS (Solo del dueño)
    // ==========================
    match /withdrawals/{withdrawalId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
    }

    // ==========================
    // TRANSACTIONS (Solo del dueño)
    // ==========================
    match /transactions/{transactionId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
    }

    // ==========================
    // RESCUE CODES (Solo admin escribe)
    // ==========================
    match /rescueCodes/{codeId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null 
                   && request.auth.token.email == "joni.lokoxon@gmail.com";
    }

  }
}
